# Development config for local Ollama inference.
# Copy to .env: cp .dev.env .env
#
# Before using, import the model into Ollama:
#   ollama create ministral -f Modelfile
#   ollama run ministral "hello"   # verify

# Ollama's OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:11434/v1

# Ollama ignores the key but the backend requires a non-empty value
OPENAI_API_KEY=ollama

# Must match the name used in `ollama create <name>`
OPENAI_MODEL=ministral

# Vite dev server
CORS_ORIGINS=http://localhost:5173

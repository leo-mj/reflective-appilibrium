# Copy to .env and fill in your values.

# ── Deployment posture ────────────────────────────────────────────────────────
#
# The single most important setting. Whether anyone but you can reach this
# server cannot be detected at runtime — behind a reverse proxy every caller
# looks local — so it is declared here, and four protections follow from it:
#
#                          local (default)      hosted
#   server-side API keys   lent to localhost    never; users bring their own
#   rate limit             none                 60/min per caller
#   session storage        on, to disk          off; the browser keeps state
#
# "local" means uvicorn and the browser on the same machine. Anything else —
# a LAN, a tunnel, a VPS, a container behind nginx — is "hosted".
DEPLOYMENT=local

# Per-provider API keys, keyed by base URL. The backend selects the matching
# key automatically when the frontend switches providers.
# For local Ollama use: LLM_API_KEYS={"http://localhost:11434/v1":"ollama"}
LLM_API_KEYS={"https://api.openai.com/v1":"sk-...","https://api.anthropic.com/v1":"sk-ant-...","https://api.mistral.ai/v1":"..."}

# Default model used when the frontend does not send an x-model header.
# For local Ollama use the name from `ollama create <name>`, e.g. ministral
DEFAULT_MODEL=gpt-4o-mini

# Output cap for a single Anthropic completion (the Messages API requires one).
# Not sent to OpenAI-compatible providers. Raise it if relation or argument
# detection over a large element set returns truncated, unparseable JSON — the
# backend logs a warning when a reply stops at the cap.
# LLM_MAX_TOKENS=4096

# Seconds one provider call may run before it is abandoned. Follows DEPLOYMENT
# (local: 600, the SDK default; hosted: 90). Raise it locally only if a slow model
# times out on large element sets. Connecting is always capped at 10s.
# LLM_TIMEOUT_SECONDS=
# Retries on connection errors, 429 and 5xx (the SDKs' own default is 2).
# LLM_MAX_RETRIES=1

# Comma-separated list of allowed CORS origins. No wildcards permitted.
# Dev: http://localhost:5173   Prod: https://your-app.com
CORS_ORIGINS=http://localhost:5173

# Directory where RE sessions are stored (defaults to <repo-root>/sessions).
# SESSIONS_DIR=/var/data/reflective-appilibrium/sessions


# ── Access control ────────────────────────────────────────────────────────────

# Comma-separated. When non-empty, every /api route except /api/health requires
# one of these values in an x-app-token header. Empty by default — a local
# install has nobody to authenticate.
#
# Issue ONE TOKEN PER PARTICIPANT for a class or study: the rate limiter buckets
# by whichever token matched, so distinct tokens give each person their own
# allowance. A single shared token authenticates fine but puts everyone in one
# bucket, which for a seminar room on shared wifi is the same problem as keying
# on IP.
# APP_ACCESS_TOKENS=alice-8f3a,bob-2c91,carol-77de


# ── Overrides ─────────────────────────────────────────────────────────────────
# Each of these follows DEPLOYMENT unless set. Only set one to depart from the
# posture above.

# Whether a caller that sends no key of its own may spend a server-side one.
# Follows DEPLOYMENT (local: yes, hosted: no). Set true on a hosted instance only
# if you run uvicorn behind --forwarded-allow-ips=<proxy ip>, so that
# request.client is the real caller rather than your proxy.
# ALLOW_LOOPBACK_SERVER_KEYS=

# Four independent per-caller caps, requests per minute; 0 disables that one.
# All four are counted in one worker's memory, so run a single uvicorn worker.
# Each follows DEPLOYMENT unless set (local: 0, hosted: as noted).
#
# Without APP_ACCESS_TOKENS a caller is its peer address. Behind a reverse proxy,
# start uvicorn with --forwarded-allow-ips=<proxy address>, or every visitor is
# the proxy and shares one allowance. The backend logs a warning when it sees this.
#
# LLM calls — one outbound request each, mostly spent waiting. Hosted: 60.
# LLM_RATE_LIMIT_PER_MINUTE=
#
# /simulate, /score_per_round — each runs a whole process to a fixed point in one
# request and holds the interpreter while it does. Hosted: 5. A handful a minute
# is already generous; /score_per_round runs one simulation per round.
# SIMULATION_RATE_LIMIT_PER_MINUTE=
#
# /step — costs what a simulation costs, but is pressed once per step by someone
# walking an evolution forward, and an evolution takes as many steps as it takes.
# Hosted: 30. On the simulation allowance it refused its sixth press.
# STEPPING_RATE_LIMIT_PER_MINUTE=
#
# /quick_score, /score_changes — analytic, and NOT user-initiated: the frontend
# fires quick_score on every edit AND once per suggestion card, so a tab of nine
# suggestions makes ten calls and accepting one re-fires all ten. No debounce
# anywhere on that path. Hosted: 300. Set this high or leave it alone — a cap
# that bites here is invisible to the person it is biting, because a failed score
# renders as a blank badge, and looks like a broken app rather than a busy one.
# SCORING_RATE_LIMIT_PER_MINUTE=

# Largest sentence pool (element count) any rethon computation will accept; 0
# disables the cap. Follows DEPLOYMENT (local: 0, hosted: 20).
#
# This bounds the cost of ONE request, which a rate limit cannot: the work grows
# like the Fibonacci numbers in the element count, about x1.6 per element. On a
# development machine a 20-element pool takes ~1s, 25 takes ~13s and 28 does not
# finish inside half a minute. The BDD is pure Python here and holds the GIL, so
# a slow request is not slow for its caller alone — it stalls the whole server.
# Raise this only if you have moved the simulation off the event loop.
# MAX_SIMULATION_ELEMENTS=

# Whether /api/sessions may read and write session files. Follows DEPLOYMENT
# (local: on, hosted: off). Turning it on for a hosted instance means that
# instance stores other people's moral reasoning on disk — a choice with
# consequences beyond the technical ones.
# SESSIONS_ENABLED=

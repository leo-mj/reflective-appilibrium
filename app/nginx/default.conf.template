# The frontend container's servers. Templates: ${…} is filled in from the
# environment when the container starts (see app/Dockerfile), here and in
# site.inc, which holds what both servers serve.
#
# Two ports, one site. They differ only in how they learn who the visitor is.
# The backend rate-limits by the address it is handed, so that address must be
# the visitor's rather than a proxy's, and must not be one the visitor made up.

# Plain HTTP. A proxy at TRUSTED_PROXY is believed about X-Forwarded-For; anyone
# else is taken to be the visitor, whatever the header says. This is also the
# port health checks and `docker compose` use.
server {
    listen 8080;
    set_real_ip_from ${TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include /etc/nginx/conf.d/site.inc;
}

# PROXY protocol: a proxy in front opens each connection with a line naming
# the visitor's address, which nginx believes from PROXY_PROTOCOL_FROM only.
# Every connection here must start with that line, so nothing else (a health
# check, a browser) can talk to this port; that is why it is a port of its own.
server {
    listen 8081 proxy_protocol;
    set_real_ip_from ${PROXY_PROTOCOL_FROM};
    real_ip_header proxy_protocol;
    include /etc/nginx/conf.d/site.inc;
}

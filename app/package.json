{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build --mode local",
    "build:backend": "vite build --mode backend",
    "lint": "eslint .",
    "format": "prettier --write .",

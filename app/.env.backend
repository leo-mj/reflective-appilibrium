# The BYOK build. `npm run build:backend` is what the public site is built with.
#
# VITE_BACKEND_URL below is a placeholder, not an address — it is here so a build
# that never set the real one fails loudly (src/config.js checks for the angle
# brackets and says so at load) rather than silently shipping a bundle whose
# every fetch throws.
#
# Set the real value in the environment at build time; Vite gives a variable
# already present in the environment priority over one in a .env file, so CI can
# supply it without editing this file. It is public in the bundle either way, so
# it is a repository variable rather than a secret.
VITE_APP_ENV=backend
VITE_BACKEND_URL=https://<deployed-backend-url>
